<Window x:Class="BookLibrary.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотека книг" 
        Height="546" Width="900"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Таблица книг -->
        <DataGrid Grid.Row="0"
                  ItemsSource="{Binding Books}"
                  SelectedItem="{Binding SelectedBook, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="0,0,0,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"      Binding="{Binding Id}" Width="60" />
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*" />
                <DataGridTextColumn Header="Автор"   Binding="{Binding Author}" Width="2*" />
                <DataGridTextColumn Header="Год"     Binding="{Binding Year}" Width="80" />
                <DataGridTextColumn Header="Жанр"    Binding="{Binding Genre.Name}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Пагинация -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="-0,0,0,8">
            <Label Content="Название" HorizontalAlignment="Left" Margin="0,1,100,0" Grid.Row="1" VerticalAlignment="Top" Width="76"/>
            <Label Content="Автор" HorizontalAlignment="Left" Margin="0,1,60,0" Grid.Row="1" VerticalAlignment="Top" Width="56"/>
            <Label Content="Год" HorizontalAlignment="Left" Margin="0,1,40,0" Grid.Row="1" VerticalAlignment="Top" Width="56"/>
            <Label Content="Жанр" HorizontalAlignment="Left" Margin="0,1,60,0" Grid.Row="1" VerticalAlignment="Top" Width="56"/>


            <Button Content="&lt; Предыдущая"
                    Command="{Binding PrevPageCommand}"
                    Margin="0,0,8,0" Width="100" />
            <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center" />
            <Button Content="Следующая &gt;"
                    Command="{Binding NextPageCommand}"
                    Margin="8,0,0,0" Width="100" />
        </StackPanel>

        <!-- Панель добавления / редактирования -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Stretch">
            <TextBox Width="160" Margin="0,0,8,0"
                     Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Название" />
            <TextBox Width="140" Margin="0,0,8,0"
                     Text="{Binding NewAuthor, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Автор" />
            <TextBox Width="60" Margin="0,0,8,0"
                     Text="{Binding NewYear, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Год" />
            <ComboBox Width="150" Margin="0,0,8,0"
                      ItemsSource="{Binding Genres}"
                      SelectedItem="{Binding SelectedGenre}"
                      DisplayMemberPath="Name" />

            <Button Content="Добавить"
                    Command="{Binding AddBookCommand}"
                    Margin="0,0,8,0" Width="100" />
            <Button Content="Редактировать"
                    Command="{Binding EditBookCommand}"
                    Margin="0,0,8,0" Width="100" />
            <Button Content="Удалить"
                    Command="{Binding DeleteBookCommand}"
                    Width="100" />
        </StackPanel>

        <StackPanel Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Left"
            Margin="0,8,0,0">
            <CheckBox Content="ID"
              IsChecked="{Binding ExportId}"
              Margin="0,0,8,0" />
            <CheckBox Content="Название"
              IsChecked="{Binding ExportTitle}"
              Margin="0,0,8,0" />
            <CheckBox Content="Автор"
              IsChecked="{Binding ExportAuthor}"
              Margin="0,0,8,0" />
            <CheckBox Content="Год"
              IsChecked="{Binding ExportYear}"
              Margin="0,0,8,0" />
            <CheckBox Content="Жанр"
              IsChecked="{Binding ExportGenre}"
              Margin="0,0,8,0" />
            <CheckBox Content="Красивый вид"
              IsChecked="{Binding HeyGoodLokin}"
              Margin="0,0,16,0" />

            <Button Content="Экспорт в JSON"
            Command="{Binding ExportJsonCommand}"
            Width="140" />
        </StackPanel>

    </Grid>

</Window>
